// Add / Edit Product dialog (ui/supervisor/product_dialog.py): identity, pricing (cost +
// product-group markup -> selling price), alias / variant groups and the GCT flag on the left,
// discounts on the right. Case items come in a later step.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AmberButton, OutlineButton, Field, FieldLabel, CheckRow, Select } from "widgets.slint";

// Looks like a dropdown; clicking opens the group chooser.
component GroupButton inherits Rectangle {
    in property <string> text;
    in property <string> placeholder: "— None —";
    in property <bool> active: true;
    callback clicked();
    height: 36px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: root.text != "" || touch.has-hover ? Theme.accent : Theme.border;
    background: white;
    Text {
        x: 10px;
        width: parent.width - 36px;
        text: root.text == "" ? root.placeholder : root.text;
        font-size: 12px;
        color: root.text == "" ? Theme.muted : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Text { x: parent.width - 24px; text: "▾"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
    touch := TouchArea { enabled: root.active; clicked => { root.clicked(); } }
}

// One discount tier: pick a shared level, a custom rule, or nothing; optional dates.
component DiscountSlotEditor inherits VerticalLayout {
    in property <string> title;
    in property <[string]> options;
    /// Index of the "Custom..." entry in `options` (0 is "None").
    in property <int> custom-index;
    in property <bool> active: true;
    in-out property <int> index;
    in-out property <string> qty;
    in-out property <string> pct;
    in-out property <string> from;
    in-out property <string> to;
    callback changed();

    alignment: start;
    vertical-stretch: 0;
    spacing: 6px;

    FieldLabel { text: root.title; }
    Select {
        options: root.options;
        index <=> root.index;
        active: root.active;
        selected(i) => { root.changed(); }
    }
    // "Buy [3] or more: [35] % off"
    if root.index == root.custom-index : HorizontalLayout {
        alignment: start;
        spacing: 6px;
        height: 34px;
        Text { text: "Buy"; font-size: 12px; color: Theme.label; vertical-alignment: center; }
        Field {
            width: 64px;
            ui-scale: 0.85;
            text <=> root.qty;
            placeholder: "3";
            active: root.active;
            edited(t) => { root.changed(); }
        }
        Text { text: "or more:"; font-size: 12px; color: Theme.label; vertical-alignment: center; }
        Field {
            width: 64px;
            ui-scale: 0.85;
            text <=> root.pct;
            placeholder: "35";
            active: root.active;
            edited(t) => { root.changed(); }
        }
        Text { text: "% off"; font-size: 12px; color: Theme.label; vertical-alignment: center; }
    }
    // "Valid [2026-12-01] to [2026-12-24]"
    if root.index != 0 : HorizontalLayout {
        alignment: start;
        spacing: 6px;
        height: 34px;
        Text { text: "Valid"; font-size: 12px; color: Theme.label; vertical-alignment: center; }
        Field {
            width: 118px;
            ui-scale: 0.85;
            text <=> root.from;
            placeholder: "YYYY-MM-DD";
            active: root.active;
            edited(t) => { root.changed(); }
        }
        Text { text: "to"; font-size: 12px; color: Theme.label; vertical-alignment: center; }
        Field {
            width: 118px;
            ui-scale: 0.85;
            text <=> root.to;
            placeholder: "YYYY-MM-DD";
            active: root.active;
            edited(t) => { root.changed(); }
        }
    }
    // The placeholders above disappear as soon as you type, so the format is also said here.
    if root.index != 0 : Text {
        text: "Dates are year-month-day, like 2026-12-24. Leave both empty for no time limit.";
        font-size: 11px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

export component ProductForm inherits Rectangle {
    in property <string> title;
    in property <bool> editing;
    /// Non-empty: this product can't be edited here yet; the text says why.
    in property <string> notice;
    in-out property <string> barcode;
    in-out property <string> name;
    in-out property <string> cost;
    in property <[string]> group-names;
    in-out property <int> group-index;
    in-out property <bool> gct: true;
    /// Alias and variant group names ("" = none); picked in the chooser.
    in property <string> alias-name;
    in property <string> variant-name;
    in property <string> price-text;
    in property <string> price-hint;
    in property <string> error-text;

    // discounts
    in property <[string]> discount-options;
    in property <int> custom-index;
    in-out property <int> d1-index;
    in-out property <string> d1-qty;
    in-out property <string> d1-pct;
    in-out property <string> d1-from;
    in-out property <string> d1-to;
    in-out property <int> d2-index;
    in-out property <string> d2-qty;
    in-out property <string> d2-pct;
    in-out property <string> d2-from;
    in-out property <string> d2-to;
    in-out property <bool> stack;
    in property <string> discount-summary;

    // case / pack item
    in-out property <bool> case;
    /// 0 = not linked (cost typed above), 1 = a single product, 2 = a variant group.
    in-out property <int> case-link-index;
    in property <string> case-link-name;
    in-out property <string> case-units;
    /// 0 = cost + shop profit, 1 = pack discount, 2 = typed price.
    in-out property <int> case-mode-index;
    in-out property <string> case-discount;
    in-out property <string> case-price;
    in property <string> case-hint;
    /// The cost comes from the single product, so it can't be typed.
    in property <bool> cost-locked;

    callback case-changed();
    callback pick-case-parent();
    callback pick-alias();
    callback pick-variant();
    callback discount-changed();
    changed case => { root.case-changed(); }
    /// Cost text or group changed: the window recalculates the price.
    callback changed();
    callback save();
    callback cancel();
    callback delete();

    background: #00000066;
    TouchArea { }   // swallow clicks on the page underneath

    init => { barcode-field.focus-input(); }

    Rectangle {
        width: min(900px, parent.width - 40px);
        height: min(48px + body.preferred-height + 12px + footer.preferred-height, parent.height - 30px);
        background: white;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

            // title bar
            Rectangle {
                y: 0px;
                height: 48px;
                background: Theme.dark;
                Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }
                Text {
                    x: 20px;
                    text: root.title;
                    color: white;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                x: 0px;
                y: 48px;
                width: parent.width;
                height: parent.height - 48px - footer.preferred-height;
                content-height: body.preferred-height + 12px;
                body := VerticalLayout {
                    y: 0px;
                    width: parent.width;
                padding: 20px;
                padding-top: 14px;
                padding-bottom: 0px;
                spacing: 8px;

                if root.notice != "" : Rectangle {
                    background: #FFF4DE;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    height: notice-text.preferred-height + 20px;
                    notice-text := Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        text: root.notice;
                        color: #6B4309;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 28px;

                    // ── left: product ──
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 6px;

                        FieldLabel { text: "Barcode *"; }
                        barcode-field := Field {
                            text <=> root.barcode;
                            placeholder: "Scan or type barcode";
                            force-upper: true;
                            active: root.notice == "";
                            accepted => { name-field.focus-input(); }
                        }
                        FieldLabel { text: "Name *"; }
                        name-field := Field {
                            text <=> root.name;
                            placeholder: "e.g. COCA COLA 330ML";
                            force-upper: true;
                            active: root.notice == "";
                            accepted => { cost-field.focus-input(); }
                        }

                        Rectangle { height: 4px; }
                        FieldLabel { text: "Cost"; }
                        cost-field := Field {
                            text <=> root.cost;
                            placeholder: "0.00";
                            active: root.notice == "" && !root.cost-locked;
                            edited(t) => { root.changed(); }
                            accepted => { root.save(); }
                        }
                        FieldLabel { text: "Selling Price"; }
                        Rectangle {
                            height: 36px;
                            background: Theme.green-light;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.green-border;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: root.price-text == "" ? "Enter a cost above to calculate" : root.price-text;
                                color: root.price-text == "" ? Theme.muted : Theme.green;
                                font-size: root.price-text == "" ? 12px : 14px;
                                font-weight: root.price-text == "" ? 500 : 700;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.price-hint;
                            color: Theme.muted;
                            font-size: 10px;
                            wrap: word-wrap;
                            visible: root.price-hint != "";
                            height: root.price-hint == "" ? 0px : self.preferred-height;
                        }

                        FieldLabel { text: "Product Group"; }
                        Select {
                            options: root.group-names;
                            index <=> root.group-index;
                            active: root.notice == "";
                            selected(i) => { root.changed(); }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { text: "Alias Group"; }
                                GroupButton {
                                    text: root.alias-name;
                                    active: root.notice == "" && !root.case;
                                    clicked => { root.pick-alias(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                FieldLabel { text: "Variant Group"; }
                                GroupButton {
                                    text: root.variant-name;
                                    active: root.notice == "" && !root.case;
                                    clicked => { root.pick-variant(); }
                                }
                            }
                        }

                        CheckRow {
                            text: "GCT Applicable";
                            checked <=> root.gct;
                        }
                        CheckRow {
                            text: "This is a case / pack of other items";
                            checked <=> root.case;
                        }
                    }

                    // ── right: discounts ──
                    VerticalLayout {
                        width: 340px;
                        alignment: start;
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "DISCOUNTS"; color: Theme.accent-dark; font-size: 11px; font-weight: 800; }
                            Text {
                                text: "Customers pay less when they buy enough of this product.";
                                color: Theme.muted;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-light; }

                        DiscountSlotEditor {
                            title: "Discount 1  ·  everyday";
                            options: root.discount-options;
                            custom-index: root.custom-index;
                            active: root.notice == "";
                            index <=> root.d1-index;
                            qty <=> root.d1-qty;
                            pct <=> root.d1-pct;
                            from <=> root.d1-from;
                            to <=> root.d1-to;
                            changed => { root.discount-changed(); }
                        }
                        DiscountSlotEditor {
                            title: "Discount 2  ·  bigger deal or promo";
                            options: root.discount-options;
                            custom-index: root.custom-index;
                            active: root.notice == "";
                            index <=> root.d2-index;
                            qty <=> root.d2-qty;
                            pct <=> root.d2-pct;
                            from <=> root.d2-from;
                            to <=> root.d2-to;
                            changed => { root.discount-changed(); }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            CheckRow {
                                text: "Discount 2 adds to discount 1";
                                checked <=> root.stack;
                            }
                            HorizontalLayout {
                                padding-left: 28px;
                                Text {
                                    text: root.stack ? "When both apply, the customer gets both added together."
                                                     : "When both apply, discount 2 is used instead of discount 1.";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.discount-summary != "" : Rectangle {
                            background: Theme.warm-white;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-light;
                            height: summary-text.preferred-height + 16px;
                            summary-text := Text {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                text: root.discount-summary;
                                color: Theme.label;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.case : Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: #FFFCF5;
                    height: case-col.preferred-height;
                    case-col := VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text { text: "CASE / PACK"; color: Theme.accent-dark; font-size: 11px; font-weight: 800; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                FieldLabel { text: "Made of"; }
                                Select {
                                    options: ["Not linked (cost typed above)", "A single product", "A variant group"];
                                    index <=> root.case-link-index;
                                    active: root.notice == "";
                                    selected(i) => { root.case-changed(); }
                                }
                            }
                            if root.case-link-index != 0 : VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                FieldLabel { text: root.case-link-index == 1 ? "Single product" : "Variant group"; }
                                GroupButton {
                                    text: root.case-link-name;
                                    placeholder: "Choose…";
                                    active: root.notice == "";
                                    clicked => { root.pick-case-parent(); }
                                }
                            }
                            VerticalLayout {
                                width: 110px;
                                spacing: 4px;
                                FieldLabel { text: "Units per case"; }
                                Field {
                                    text <=> root.case-units;
                                    placeholder: "12";
                                    active: root.notice == "";
                                    edited(t) => { root.case-changed(); }
                                }
                            }
                        }
                        if root.case-link-index != 0 : HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                FieldLabel { text: "Case price"; }
                                Select {
                                    options: ["Cost + shop profit %", "Pack discount % off the singles", "Typed price"];
                                    index <=> root.case-mode-index;
                                    active: root.notice == "";
                                    selected(i) => { root.case-changed(); }
                                }
                            }
                            if root.case-mode-index == 1 : VerticalLayout {
                                width: 130px;
                                spacing: 4px;
                                FieldLabel { text: "Pack discount %"; }
                                Field {
                                    text <=> root.case-discount;
                                    placeholder: "10";
                                    active: root.notice == "";
                                    edited(t) => { root.case-changed(); }
                                }
                            }
                            if root.case-mode-index == 2 : VerticalLayout {
                                width: 130px;
                                spacing: 4px;
                                FieldLabel { text: "Case price"; }
                                Field {
                                    text <=> root.case-price;
                                    placeholder: "0.00";
                                    active: root.notice == "";
                                    edited(t) => { root.case-changed(); }
                                }
                            }
                        }
                        Text {
                            text: root.case-hint;
                            color: Theme.muted;
                            font-size: 10px;
                            wrap: word-wrap;
                            visible: root.case-hint != "";
                            height: root.case-hint == "" ? 0px : self.preferred-height;
                        }
                    }
                }
                }
            }

            footer := VerticalLayout {
                x: 0px;
                y: parent.height - self.preferred-height;
                width: parent.width;
                padding: 20px;
                padding-top: 8px;
                spacing: 8px;
                if root.error-text != "" : Text {
                    text: root.error-text;
                    color: Theme.red;
                    font-size: 12px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Rectangle { height: 2px; }
                HorizontalLayout {
                    spacing: 10px;
                    if root.editing : Rectangle {
                        width: 90px;
                        height: 40px;
                        border-radius: 8px;
                        border-width: 1.5px;
                        border-color: Theme.red-border;
                        background: del-touch.has-hover ? Theme.red-light : transparent;
                        Text {
                            text: "Delete";
                            color: Theme.red;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        del-touch := TouchArea { clicked => { root.delete(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    OutlineButton { width: 100px; text: "Cancel"; clicked => { root.cancel(); } }
                    AmberButton {
                        width: 120px;
                        height: 40px;
                        text: "Save";
                        active: root.notice == "";
                        clicked => { root.save(); }
                    }
                }
            }
    }
}
