import { Theme } from "theme.slint";

// Shared building blocks (login + setup wizard).

export component HexLogo inherits Rectangle {
    in property <length> size: 44px;
    width: size;
    height: size;
    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 2 L 91 26 L 91 74 L 50 98 L 9 74 L 9 26 Z";
        fill: Theme.accent;
    }
}

export component AmberButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: true;
    in property <float> ui-scale: 1.0;
    callback clicked();

    height: 42px * ui-scale;
    border-radius: 8px;
    background: !active ? #D3D1C7
        : touch.pressed ? Theme.accent-darker
        : touch.has-hover ? Theme.accent-dark
        : Theme.accent;

    touch := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: white;
        font-size: 14px * root.ui-scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ZoomButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 5px;
    border-width: 1px;
    background: white;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: touch.has-hover ? Theme.accent : Theme.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> force-upper: false;
    in property <bool> active: true;
    in property <float> ui-scale: 1.0;
    callback accepted();
    callback edited(string);
    property <bool> revealed: false;

    public function focus-input() { input.focus(); }

    height: 40px * ui-scale;
    border-radius: 8px;
    border-width: 1px;
    background: input.has-focus ? white : #FAFAF8;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;

        Rectangle {
            input := TextInput {
                x: 0px;
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                font-size: 13px * root.ui-scale;
                color: Theme.text;
                enabled: root.active;
                input-type: (root.secret && !root.revealed) ? InputType.password : InputType.text;
                accepted => { root.accepted(); }
                edited => {
                    if (root.force-upper && self.text != self.text.to-uppercase()) {
                        self.text = self.text.to-uppercase();
                    }
                    root.edited(self.text);
                }
            }
            if input.text == "" : Text {
                x: 0px;
                width: parent.width;
                horizontal-alignment: left;
                text: root.placeholder;
                color: #A9A69D;
                font-size: 13px * root.ui-scale;
                vertical-alignment: center;
            }
        }

        if root.secret : Rectangle {
            width: 44px;
            Text {
                text: root.revealed ? "Hide" : "Show";
                font-size: 12px * root.ui-scale;
                color: eye.has-hover ? Theme.label : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            eye := TouchArea { clicked => { root.revealed = !root.revealed; } }
        }
    }
}

export component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: true;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    border-width: 1.5px;
    background: transparent;
    border-color: !active ? Theme.border-light : touch.has-hover ? Theme.accent : Theme.border;

    touch := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: !root.active ? Theme.muted : touch.has-hover ? Theme.accent : Theme.label;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component FieldLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Theme.label;
}

export component CheckRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: true;
    height: 28px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1.5px;
            border-color: root.checked ? Theme.accent : Theme.border;
            background: root.checked ? Theme.accent : white;
            if root.checked : Text {
                text: "✓";
                color: white;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.checked = !root.checked; } }
}

// Multi-line box: Enter adds a line. One typed line = one printed line.
export component AreaField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> box-height: 72px;
    in property <bool> force-upper: true;
    callback edited(string);

    public function focus-input() { input.focus(); }

    height: box-height;
    border-radius: 8px;
    border-width: 1px;
    background: input.has-focus ? white : #FAFAF8;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    Rectangle {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: parent.height - 16px;
        clip: true;
        input := TextInput {
            x: 0px;
            y: 0px;
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.text;
            edited => {
                if (root.force-upper && self.text != self.text.to-uppercase()) {
                    self.text = self.text.to-uppercase();
                }
                root.edited(self.text);
            }
        }
        if input.text == "" : Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            text: root.placeholder;
            color: #A9A69D;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}
